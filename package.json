{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run lfs:fetch && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lfs:fetch": "node scripts/fetch-lfs-assets.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run --testTimeout=35000",
    "seed:build": "tsx scripts/build-seed-bundle.ts",
    "seed:manifest": "tsx scripts/generate-seed-manifest.ts",
    "dict:import-decs": "tsx scripts/import-decs.ts",
    "dict:import-rename": "tsx scripts/import-rename.ts",
    "dict:import-tuss": "tsx scripts/import-tuss.ts",
    "automaton:build": "tsx scripts/build-ner-automaton.ts",
    "db:build": "tsx scripts/convert-to-sqlite.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^7.6.8",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/network": "^7.0.4",
    "@google/genai": "^2.15.0",
    "@napi-rs/canvas": "^1.0.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dexie": "^4.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "4.10.38",
    "pdfmake": "^0.3.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdfmake": "^0.3.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "iOS >= 15",
    "Android >= 90",
    "Chrome >= 90",
    "Safari >= 15",
    "Firefox >= 90",
    "last 2 versions",
    "not dead"
  ],
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.35.3": true
  }
}
