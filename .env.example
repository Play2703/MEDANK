# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# GROQ_API_KEY: Provedor de fallback ultra-rápido (modelos com alto TPM no tier free: openai/gpt-oss-120b, openai/gpt-oss-20b)
GROQ_API_KEY=""

# MISTRAL_API_KEY: Provedor de fallback Mistral AI (endpoint: https://api.mistral.ai/v1, modelo: mistral-small-latest)
MISTRAL_API_KEY=""

# CLOUDFLARE WORKERS AI (fallback com 10.000 Neurons/dia no tier free genuíno)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Concorrência máxima para geração de questões (protege contra estouro de TPM do Groq/Mistral)
QUESTION_GEN_CONCURRENCY=2

# 9Router AI Gateway (fallback final com múltiplos modelos sem redundância do Groq)
AI_GATEWAY_BASE_URL=""
AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODELS="mistralai/mistral-small-24b-instruct-2501,meta-llama/llama-3.3-70b-instruct"


# APP_URL: The URL where this applet is hosted.
APP_URL="https://medank.onrender.com"

# DeCS / BIREME (licença de uso). Nunca commitar o token/senha.
DECS_API_TOKEN=
DECS_API_BASE=https://api.bvsalud.org/decs/v2
DECS_FTP_HOST=ftp.bireme.br
DECS_FTP_USER=decs_pt
DECS_FTP_PASS=
DECS_FTP_FILE=decs_portugues_2026.tgz

# NER: chamar Gemini só quando a cobertura local for insuficiente.
# Default: false (economia de tokens). true = comportamento antigo híbrido sempre-on.
ENABLE_AI_NER=false

